{
  "name": "@chubbyts/chubbyts-dic-types",
  "type": "module",
  "version": "2.3.0",
  "description": "Dependency injection container (DIC) types, PSR-11 inspired.",
  "keywords": [
    "chubbyts",
    "dic",
    "dependency injection container",
    "dependency injection",
    "container",
    "PSR-11"
  ],
  "author": "Dominik Zogg",
  "license": "MIT",
  "repository": "chubbyts/chubbyts-dic-types",
  "scripts": {
    "build": "rm -Rf dist && tsc",
    "cs-fix": "prettier --write src",
    "cs": "prettier --check src",
    "infection": "stryker run",
    "lint-fix": "oxlint --fix src",
    "lint": "oxlint src",
    "prepare": "pnpm run build"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./*.d.ts",
      "import": "./*.js",
      "default": "./*.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@chubbyts/chubbyts-oxlint": "^1.0.0",
    "@types/node": "^26.1.2",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
